rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSchoolUser(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('(?i)^.+@derbygrammar\\.org$');
    }

    function isBootstrapAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'wesley.m@derbygrammar.org';
    }

    function isStaff() {
      return isBootstrapAdmin()
        || (
          request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email is string
          && request.auth.token.email.matches('(?i)^.+@derbygrammar\\.org$')
          && exists(/databases/$(database)/documents/staff/$(request.auth.token.email))
          && get(/databases/$(database)/documents/staff/$(request.auth.token.email)).data.role in ['teacher', 'admin']
        );
    }

    function validProfile(userId) {
      return isSchoolUser(userId)
        && request.resource.data.keys().hasOnly(['email', 'lastLogin'])
        && request.resource.data.keys().hasAll(['email', 'lastLogin'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.lastLogin is timestamp;
    }

    function validStaffRecord(email) {
      return request.resource.data.keys().hasOnly(['email', 'role', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasAll(['email', 'role', 'updatedAt', 'updatedBy'])
        && request.resource.data.email == email
        && email.matches('(?i)^.+@derbygrammar\\.org$')
        && request.resource.data.role in ['teacher', 'admin']
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.token.email;
    }

    function validClassData() {
      return request.resource.data.keys().hasOnly(['name', 'memberIds', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasAll(['name', 'memberIds', 'updatedAt', 'updatedBy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() <= 200
        && request.resource.data.memberIds.toSet().size() == request.resource.data.memberIds.size()
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy is string
        && request.resource.data.updatedBy == request.auth.token.email;
    }

    function sameClassMembers() {
      return request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && resource.data.memberIds.hasAll(request.resource.data.memberIds);
    }

    function addsOneClassMember() {
      return request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberIds.hasAll(resource.data.memberIds)
        && !resource.data.memberIds.hasAny([
          request.resource.data.memberIds[request.resource.data.memberIds.size() - 1]
        ])
        && exists(/databases/$(database)/documents/users/$(request.resource.data.memberIds[request.resource.data.memberIds.size() - 1]));
    }

    function removesOneClassMember() {
      return resource.data.memberIds.size() == request.resource.data.memberIds.size() + 1
        && resource.data.memberIds.hasAll(request.resource.data.memberIds);
    }

    function validClassUpdate() {
      return validClassData()
        && (
          (request.resource.data.name != resource.data.name && sameClassMembers())
          || (
            request.resource.data.name == resource.data.name
            && (addsOneClassMember() || removesOneClassMember())
          )
        );
    }

    function validLesson1Tasks(tasks) {
      return tasks is list
        && tasks.size() == 10
        && tasks[0] is bool && tasks[1] is bool
        && tasks[2] is bool && tasks[3] is bool
        && tasks[4] is bool && tasks[5] is bool
        && tasks[6] is bool && tasks[7] is bool
        && tasks[8] is bool && tasks[9] is bool;
    }

    function validEightTasks(tasks) {
      return tasks is list
        && tasks.size() == 8
        && tasks[0] is bool && tasks[1] is bool
        && tasks[2] is bool && tasks[3] is bool
        && tasks[4] is bool && tasks[5] is bool
        && tasks[6] is bool && tasks[7] is bool;
    }

    function validProgress(lessonId) {
      return request.resource.data.keys().hasOnly(['completedTasks', 'updatedAt'])
        && request.resource.data.keys().hasAll(['completedTasks', 'updatedAt'])
        && request.resource.data.updatedAt is timestamp
        && (
          (lessonId == 'lesson1' && validLesson1Tasks(request.resource.data.completedTasks))
          || (lessonId in ['lesson2', 'lesson3', 'lesson4', 'lesson5', 'lesson6']
            && validEightTasks(request.resource.data.completedTasks))
        );
    }

    function validWebText(fields, key, limit) {
      return fields.get(key, '') is string && fields.get(key, '').size() <= limit;
    }

    function validLesson1WebFields(fields) {
      return fields is map
        && fields.keys().hasOnly([
          'brick-ideas', 'brick-count', 'brick-time', 'style-reflection',
          'recap-structure', 'recap-display', 'recap-mistakes',
          'gap-1', 'gap-2', 'gap-3', 'gap-4', 'gap-5', 'gap-6',
          'gap-7', 'gap-8', 'gap-9', 'gap-10', 'homework-reflection',
          'lesson-complete', 'html-editor'
        ])
        && validWebText(fields, 'brick-ideas', 20000)
        && validWebText(fields, 'brick-count', 20000)
        && validWebText(fields, 'brick-time', 20000)
        && validWebText(fields, 'style-reflection', 20000)
        && validWebText(fields, 'recap-structure', 20000)
        && validWebText(fields, 'recap-display', 20000)
        && validWebText(fields, 'recap-mistakes', 20000)
        && validWebText(fields, 'gap-1', 20000)
        && validWebText(fields, 'gap-2', 20000)
        && validWebText(fields, 'gap-3', 20000)
        && validWebText(fields, 'gap-4', 20000)
        && validWebText(fields, 'gap-5', 20000)
        && validWebText(fields, 'gap-6', 20000)
        && validWebText(fields, 'gap-7', 20000)
        && validWebText(fields, 'gap-8', 20000)
        && validWebText(fields, 'gap-9', 20000)
        && validWebText(fields, 'gap-10', 20000)
        && validWebText(fields, 'homework-reflection', 20000)
        && fields.get('lesson-complete', 'false') in ['true', 'false']
        && validWebText(fields, 'html-editor', 200000);
    }

    function validLaterWebFields(fields) {
      return fields is map
        && fields.keys().hasOnly([
          'question-1', 'question-2', 'question-3', 'question-4', 'question-5',
          'homework-1', 'reflection', 'search-query', 'lesson-complete',
          'html-editor', 'css-editor', 'page-about', 'page-gallery'
        ])
        && validWebText(fields, 'question-1', 20000)
        && validWebText(fields, 'question-2', 20000)
        && validWebText(fields, 'question-3', 20000)
        && validWebText(fields, 'question-4', 20000)
        && validWebText(fields, 'question-5', 20000)
        && validWebText(fields, 'homework-1', 20000)
        && validWebText(fields, 'reflection', 20000)
        && validWebText(fields, 'search-query', 20000)
        && fields.get('lesson-complete', 'false') in ['true', 'false']
        && validWebText(fields, 'html-editor', 200000)
        && validWebText(fields, 'css-editor', 200000)
        && validWebText(fields, 'page-about', 20000)
        && validWebText(fields, 'page-gallery', 20000);
    }

    function validWebFields(fields, lessonId) {
      return (lessonId == 'lesson1' && validLesson1WebFields(fields))
        || (lessonId in ['lesson2', 'lesson3', 'lesson4', 'lesson5', 'lesson6']
          && validLaterWebFields(fields));
    }

    match /users/{userId} {
      allow get: if isSchoolUser(userId) || isStaff();
      allow list: if isStaff();
      allow create, update: if validProfile(userId);
      allow delete: if false;

      match /progress/{lessonId} {
        allow read: if (isSchoolUser(userId) || isStaff())
          && lessonId in ['lesson1', 'lesson2', 'lesson3', 'lesson4', 'lesson5', 'lesson6'];
        allow create, update: if isSchoolUser(userId)
          && lessonId in ['lesson1', 'lesson2', 'lesson3', 'lesson4', 'lesson5', 'lesson6']
          && validProgress(lessonId);
        allow delete: if false;
      }

      match /webWork/{lessonId} {
        allow read: if isSchoolUser(userId)
          && lessonId in ['lesson1', 'lesson2', 'lesson3', 'lesson4', 'lesson5', 'lesson6'];
        allow create, update: if isSchoolUser(userId)
          && lessonId in ['lesson1', 'lesson2', 'lesson3', 'lesson4', 'lesson5', 'lesson6']
          && request.resource.data.keys().hasOnly(['revision', 'fields', 'updatedAt'])
          && request.resource.data.keys().hasAll(['revision', 'fields', 'updatedAt'])
          && request.resource.data.revision is int
          && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
          && request.resource.data.updatedAt is timestamp
          && validWebFields(request.resource.data.fields, lessonId)
          && getAfter(/databases/$(database)/documents/users/$(userId)/webProgress/$(lessonId)).data.completed
            == (request.resource.data.fields.get('lesson-complete', 'false') == 'true');
        allow delete: if false;
      }

      match /webProgress/{lessonId} {
        allow read: if (isSchoolUser(userId) || isStaff())
          && lessonId in ['lesson1', 'lesson2', 'lesson3', 'lesson4', 'lesson5', 'lesson6'];
        allow create, update: if isSchoolUser(userId)
          && lessonId in ['lesson1', 'lesson2', 'lesson3', 'lesson4', 'lesson5', 'lesson6']
          && request.resource.data.keys().hasOnly(['completed', 'updatedAt'])
          && request.resource.data.keys().hasAll(['completed', 'updatedAt'])
          && request.resource.data.completed is bool
          && request.resource.data.updatedAt is timestamp
          && request.resource.data.completed
            == (getAfter(/databases/$(database)/documents/users/$(userId)/webWork/$(lessonId)).data.fields.get('lesson-complete', 'false') == 'true');
        allow delete: if false;
      }
    }

    match /staff/{email} {
      allow get: if isStaff()
        || (
          request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.token.email == email
        );
      allow list: if isStaff();
      allow create, update: if isBootstrapAdmin() && validStaffRecord(email);
      allow delete: if isBootstrapAdmin() && email != 'wesley.m@derbygrammar.org';
    }

    match /classes/{classId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && validClassData()
        && request.resource.data.memberIds.size() == 0;
      allow update: if isStaff() && validClassUpdate();
      allow delete: if isStaff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
