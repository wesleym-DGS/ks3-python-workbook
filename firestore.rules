rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSchoolUser(userId) {
      return request.auth != null
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('(?i)^.+@derbygrammar\\.org$');
    }

    function validLesson1Tasks(tasks) {
      return tasks is list
        && tasks.size() == 10
        && tasks[0] is bool && tasks[1] is bool
        && tasks[2] is bool && tasks[3] is bool
        && tasks[4] is bool && tasks[5] is bool
        && tasks[6] is bool && tasks[7] is bool
        && tasks[8] is bool && tasks[9] is bool;
    }

    function validLesson2Tasks(tasks) {
      return tasks is list
        && tasks.size() == 6
        && tasks[0] is bool && tasks[1] is bool
        && tasks[2] is bool && tasks[3] is bool
        && tasks[4] is bool && tasks[5] is bool;
    }

    function validProgress(lessonId) {
      return request.resource.data.keys().hasOnly(['completedTasks', 'updatedAt'])
        && request.resource.data.keys().hasAll(['completedTasks', 'updatedAt'])
        && request.resource.data.updatedAt is timestamp
        && (
          (lessonId == 'lesson1' && validLesson1Tasks(request.resource.data.completedTasks))
          || (lessonId == 'lesson2' && validLesson2Tasks(request.resource.data.completedTasks))
        );
    }

    match /users/{userId}/progress/{lessonId} {
      allow read: if isSchoolUser(userId)
        && lessonId in ['lesson1', 'lesson2'];
      allow create, update: if isSchoolUser(userId)
        && lessonId in ['lesson1', 'lesson2']
        && validProgress(lessonId);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
